// Équatis — schéma Prisma single-tenant
// Généré pour Phase 1. Toute modification doit passer par une migration versionnée.
// Conformité CDC v1.0 — 4 espaces cloisonnés (Collaborateur, Promoteur, Notaire, Client).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// ENUMS
// =====================================================

enum UserRole {
  SUPER_ADMIN
  COLLABORATOR
  PROMOTER
  NOTARY
  CLIENT
}

enum UserStatus {
  PENDING_EMAIL // inscription faite, email pas encore confirmé
  PENDING_ASSOCIATION // client confirmé mais pas associé à un dossier
  ACTIVE
  SUSPENDED
  DELETION_REQUESTED // demande RGPD en cours, soft-deleted
  NO_ACCOUNT // « client associé » : fiche de contact sans accès plateforme (pas de connexion, pas d'email automatique)
}

enum ProgrammeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum LotStatus {
  AVAILABLE
  OPTIONED
  RESERVED
  SOLD
  WITHDRAWN
}

enum DossierStatus {
  NEW_LEAD
  RESERVATION_SENT
  SIGNATURE_PENDING
  SIGNED_AT_NOTARY
  LOAN_OFFER_RECEIVED
  ACT_SIGNED
  BLOCKED
}

enum DossierRole {
  COLLABORATOR_PRIMARY
  COLLABORATOR_SECONDARY
  NOTARY
}

// Axe contractuel — parallèle au cycle commercial DossierStatus (CDC évolution §4).
enum ContractStatus {
  AWAITING_SIGNATURE // En attente de signature
  RESERVATION_SIGNED // Réservation signée
  CONTRACT_SIGNED // Contrat signé
  SENT_TO_NOTARY // Envoyé chez le notaire
  NOTARY_ACT_PENDING // Signature d'acte en cours
  LOAN_OFFER_PENDING // Offre de prêt en attente
  LOAN_OFFER_RECEIVED // Offre de prêt reçue
  LOAN_OFFER_SENT_TO_NOTARY // Offre de prêt envoyée au notaire — en attente de RDV
  NOTARY_APPOINTMENT_SCHEDULED // RDV notaire planifié
}

enum FamilyStatus {
  SINGLE
  MARRIED
  PACS
  DIVORCED
  WIDOWED
  COHABITING
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT_TO_NOTARY
  PAID
}

enum NoteScope {
  PROSPECT
  DOSSIER
}

enum DocumentScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
}

enum DocumentRequestStatus {
  PENDING
  ACCEPTED
  REFUSED
}

// Revue d'un document déposé, au niveau du document (le collaborateur accepte
// ou refuse chaque fichier individuellement).
enum DocumentReviewStatus {
  PENDING
  ACCEPTED
  REFUSED
}

enum DocumentSource {
  COLLABORATOR_UPLOAD
  CLIENT_UPLOAD
  YOUSIGN_SIGNED
  PROGRAMME_RESOURCE
}

enum ProgrammeDocumentCategory {
  PLAN
  PERMIS
  NOTICE
  BUDGET
  ACTE
}

enum TimelineKind {
  LEAD_CREATED
  COMMERCIAL_MEETING
  RESERVATION_SENT
  RESERVATION_SIGNED
  NOTARY_ACT_PENDING
  TRANSMITTED_TO_NOTARY
  GUARANTEE_DEPOSIT_RECEIVED
  LOAN_OFFER_RECEIVED
  ACT_SIGNED
  STATUS_CHANGE
  CONTRACT_STATUS_CHANGE
  DOCUMENT_REQUESTED
  OPTION_TAKEN
  OPTION_REMINDER
  APPOINTMENT_SCHEDULED
  INVOICE_SENT
  CUSTOM
}

enum SignatureStatus {
  CREATED
  SENT
  OPENED
  SIGNED
  REFUSED
  EXPIRED
  ERROR
}

enum NotificationKind {
  NEW_DOCUMENT
  DOCUMENT_REQUESTED
  SIGNATURE_COMPLETED
  DOSSIER_INACTIVE
  NEW_LEAD
  TRANSMITTED_TO_NOTARY
  MISSING_PIECE_REPORTED
  NEW_MESSAGE
  DOSSIER_ASSOCIATED
  ACT_READY
  APPOINTMENT_SCHEDULED
  CONTRACT_STATUS_CHANGE
  OPTION_REMINDER
  INVOICE_RECEIVED
}

// =====================================================
// AUTH & USERS
// =====================================================

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  emailVerifiedAt DateTime?
  passwordHash    String
  role            UserRole
  status          UserStatus @default(PENDING_EMAIL)

  firstName  String
  lastName   String
  // Champs sensibles : chiffrés AES-256-GCM côté application (clé via env).
  // Stockés sous forme `iv:tag:ciphertext` en base64.
  phoneEnc   String?
  addressEnc String?
  // Adresses email supplémentaires (conjoint, etc.) — texte libre chiffré.
  additionalEmailsEnc String?

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions           Session[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  dossierLinks       DossierParticipant[]
  // Un client peut avoir un dossier actif et plusieurs dossiers archivés (historique).
  clientDossiers     Dossier[]            @relation("DossierClient")
  promoterProgrammes ProgrammePromoter[]
  uploadedDocs       Document[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  sentMessages       Message[]
  signaturesAsSigner Signature[]          @relation("SignatureSigner")
  ownedProspects     Prospect[]           @relation("ProspectOwner")
  clientProfile      ClientProfile?
  authoredNotes      Note[]               @relation("NoteAuthor")
  createdAppointments Appointment[]       @relation("AppointmentCreator")
  createdInvoices    Invoice[]            @relation("InvoiceCreator")
  sentDirectMessages     DirectMessage[]  @relation("DMSender")
  receivedDirectMessages DirectMessage[]  @relation("DMRecipient")

  @@index([role])
  @@index([status])
}

// Refresh tokens persistés. L'access token JWT est volatile (1h) et n'est pas stocké.
model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerification {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Trace de chaque tentative — base du rate limiting (5 échecs → 15 min).
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// =====================================================
// PROGRAMMES & LOTS
// =====================================================

model Programme {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?
  zipcode     String?
  city        String?
  address     String?
  status      ProgrammeStatus @default(ACTIVE)
  totalLots   Int             @default(0)
  caObjective Decimal?        @db.Decimal(14, 2)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  lots            Lot[]
  dossiers        Dossier[]
  documents       ProgrammeDocument[]
  promoters       ProgrammePromoter[]
  tresorerie      TresoreriePrev[]
  prospects       Prospect[]
  lotFondsSuivis  LotFondsSuivi[]
  appelsFonds     AppelFonds[]

  @@index([status])
}

// Plusieurs promoteurs possibles par programme.
model ProgrammePromoter {
  programmeId String
  promoterId  String
  createdAt   DateTime @default(now())

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  promoter  User      @relation(fields: [promoterId], references: [id], onDelete: Cascade)

  @@id([programmeId, promoterId])
  @@index([promoterId])
}

model Lot {
  id          String    @id @default(cuid())
  programmeId String
  dossierId   String?
  reference   String
  surface     Decimal   @db.Decimal(8, 2)
  floor       Int?
  type        String
  priceHT     Decimal   @db.Decimal(12, 2)
  vatRate     Decimal   @db.Decimal(5, 2)
  priceTTC    Decimal   @db.Decimal(12, 2)
  status      LotStatus @default(AVAILABLE)
  notes       String?

  // Localisation / annexes
  building     String?
  annexSurface Decimal? @db.Decimal(8, 2)
  garden       Decimal? @db.Decimal(8, 2)
  // Surface utile SUV — valeur saisie/importée telle quelle (aucun recalcul).
  suv          Decimal? @db.Decimal(8, 2)

  // Champs financiers additionnels (tracking import)
  priceNetVendeur            Decimal? @db.Decimal(12, 2)
  priceNetVendeurWithParking Decimal? @db.Decimal(12, 2)
  commissionAgence           Decimal? @db.Decimal(12, 2)
  commissionAgenceParking    Decimal? @db.Decimal(12, 2)
  priceLocation              Decimal? @db.Decimal(12, 2)
  creditImpot35              Decimal? @db.Decimal(12, 2)
  priceRevientCrdImp         Decimal? @db.Decimal(12, 2)
  additionalParking          Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programme   Programme      @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  dossier     Dossier?       @relation(fields: [dossierId], references: [id])
  // Dossiers archivés du lot : historique des clients précédents.
  archivedDossiers Dossier[] @relation("DossierArchivedLot")
  fondsSuivi  LotFondsSuivi?

  @@unique([programmeId, reference])
  @@index([programmeId, status])
  @@index([dossierId])
}

// Trésorerie prévisionnelle : 1 ligne par mois.
model TresoreriePrev {
  id          String   @id @default(cuid())
  programmeId String
  month       DateTime
  income      Decimal  @default(0) @db.Decimal(14, 2)
  expense     Decimal  @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@unique([programmeId, month])
}

// =====================================================
// DOSSIERS
// =====================================================

model Dossier {
  id          String        @id @default(cuid())
  programmeId String
  // Plusieurs dossiers possibles par client : un seul actif (archivedAt = null),
  // les autres archivés (historique conservé après dissociation).
  clientId    String?
  status      DossierStatus @default(NEW_LEAD)
  // Axe contractuel parallèle (null tant que le dossier n'est pas en phase contrat).
  contractStatus ContractStatus?

  // Option : dossier « optionné » — capable d'acheter mais avec délai.
  optioned        Boolean   @default(false)
  optionExpiresAt DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  // Mis à jour automatiquement par triggers applicatifs : base des relances auto.
  lastActivityAt      DateTime  @default(now())
  closedAt            DateTime?
  // Dossier archivé à la dissociation du client : messages, documents et timeline
  // sont conservés et restitués si le même client est réassocié au même lot.
  archivedAt          DateTime?
  // Lot concerné par un dossier archivé. `Lot.dossierId` ne désigne que le dossier
  // ACTIF : sans cette trace, le couple (lot, client) serait perdu à la dissociation
  // et l'historique du client ne pourrait plus être restitué.
  archivedLotId       String?
  notaryId            String?
  notaryTransmittedAt DateTime?

  // Suivi du process de vente (dates brutes saisies, en plus des enums status/contractStatus)
  observation                String?
  financingMode              String?
  kbisObtainedAt             DateTime?
  clientAtRsm                Boolean?
  reservationSignedAt        DateTime?
  deposit200ReceivedAt       DateTime?
  guaranteeDepositAmount     Decimal?  @db.Decimal(12, 2)
  guaranteeDepositReceivedAt DateTime?
  rarSentByNotaryAt          DateTime?
  loanFiledAt                DateTime?
  loanObtainedAt             DateTime?
  reservationEndDate         DateTime?
  actSignedAt                DateTime?

  programme        Programme            @relation(fields: [programmeId], references: [id])
  lots             Lot[]
  archivedLot      Lot?                 @relation("DossierArchivedLot", fields: [archivedLotId], references: [id], onDelete: SetNull)
  client           User?                @relation("DossierClient", fields: [clientId], references: [id])
  participants     DossierParticipant[]
  documents        Document[]
  documentRequests DocumentRequest[]
  timelineEvents   TimelineEvent[]
  messages         Message[]
  signatures       Signature[]
  prospect         Prospect?            @relation("ProspectConverted")
  appointments     Appointment[]
  invoices         Invoice[]
  notes            Note[]

  @@index([status])
  @@index([programmeId])
  @@index([lastActivityAt])
  @@index([notaryId, status])
  @@index([contractStatus])
  @@index([optioned])
  @@index([clientId])
  @@index([archivedAt])
  @@index([archivedLotId, clientId])
}

// Lien M2M : un user peut être collaborateur principal/secondaire ou notaire d'un dossier.
model DossierParticipant {
  dossierId String
  userId    String
  role      DossierRole
  createdAt DateTime    @default(now())

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([dossierId, userId, role])
  @@index([userId, role])
}

// =====================================================
// DOCUMENTS
// =====================================================

model Document {
  id                String             @id @default(cuid())
  dossierId         String?
  uploadedById      String
  fileName          String
  mimeType          String
  sizeBytes         Int
  storageKey        String             @unique
  source            DocumentSource
  scanStatus        DocumentScanStatus   @default(PENDING)
  scanCheckedAt     DateTime?
  isShared          Boolean              @default(false)
  documentRequestId String?
  reviewStatus      DocumentReviewStatus @default(PENDING)
  reviewReason      String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  dossier    Dossier?         @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  uploadedBy User             @relation(fields: [uploadedById], references: [id])
  request    DocumentRequest? @relation(fields: [documentRequestId], references: [id])

  @@index([dossierId, createdAt])
  @@index([scanStatus])
  @@index([uploadedById])
}

// Documents attachés à un programme (plans, permis, notice, budget, acte type).
model ProgrammeDocument {
  id          String                     @id @default(cuid())
  programmeId String
  fileName    String
  storageKey  String                     @unique
  mimeType    String
  sizeBytes   Int
  category    ProgrammeDocumentCategory

  createdAt DateTime @default(now())

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@index([programmeId, category])
}

// Pièces demandées au client par le collaborateur (ex : pièce d'identité recto, RIB, etc.).
model DocumentRequest {
  id        String                @id @default(cuid())
  dossierId String
  label     String
  required  Boolean               @default(true)
  fulfilled Boolean               @default(false)
  status    DocumentRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dossier   Dossier    @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([dossierId, fulfilled])
}

// =====================================================
// TIMELINE
// =====================================================

model TimelineEvent {
  id          String       @id @default(cuid())
  dossierId   String
  kind        TimelineKind
  title       String
  description String?
  occurredAt  DateTime     @default(now())
  actorId     String?

  createdAt DateTime @default(now())

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId, occurredAt])
}

// =====================================================
// MESSAGERIE CLIENT ↔ COLLABORATEUR
// =====================================================

model Message {
  id        String @id @default(cuid())
  dossierId String
  senderId  String
  body      String
  // IDs des utilisateurs ayant lu le message (hors expéditeur).
  readBy               String[] @default([])
  sentByEmail          Boolean  @default(false)
  emailAttachmentCount Int      @default(0)

  createdAt DateTime @default(now())

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id])

  @@index([dossierId, createdAt])
}

// =====================================================
// SIGNATURE ÉLECTRONIQUE (Yousign SES)
// =====================================================

model Signature {
  id                 String          @id @default(cuid())
  dossierId          String
  documentId         String?
  yousignProcedureId String?         @unique
  status             SignatureStatus @default(CREATED)
  signerEmail        String
  signerUserId       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  signedAt  DateTime?

  dossier    Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  signerUser User?   @relation("SignatureSigner", fields: [signerUserId], references: [id])

  @@index([dossierId, status])
  @@index([yousignProcedureId])
}

// =====================================================
// NOTIFICATIONS IN-APP
// =====================================================

model Notification {
  id     String           @id @default(cuid())
  userId String
  kind   NotificationKind
  title  String
  body   String?
  link   String?
  readAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// =====================================================
// MESSAGERIE INTERNE — entre membres de l'équipe (hors client)
// =====================================================

model DirectMessage {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String
  // Document joint optionnel (S3).
  attachmentKey  String?
  attachmentName String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  sender    User @relation("DMSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("DMRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

// =====================================================
// AUDIT LOGS — conservation 5 ans (CDC §8.6)
// =====================================================

model AuditLog {
  id           String  @id @default(cuid())
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  metadata     String?
  ip           String?
  userAgent    String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([action, createdAt])
}

// =====================================================
// PARAMÈTRES GLOBAUX (CDC §9.3)
// =====================================================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// =====================================================
// PROSPECTS (CRM léger — Google Forms import)
// =====================================================

enum ProspectStatus {
  NEW
  QUALIFIED
  OPTIONED // « réservataire » : prospect ayant réservé, prêt à être converti en client
  CONVERTED
  DROPPED
}

model Prospect {
  id          String         @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  city        String?
  programmeId String?
  source      String?
  notes       String?
  status      ProspectStatus @default(NEW)
  ownerId     String?
  convertedDossierId String? @unique

  // Option : prospect « optionné » — capable d'acheter mais avec délai (ex. 3 mois).
  optionExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programme        Programme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  owner            User?      @relation("ProspectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  convertedDossier Dossier?   @relation("ProspectConverted", fields: [convertedDossierId], references: [id], onDelete: SetNull)
  sharedNotes      Note[]

  @@unique([email, programmeId])
  @@index([status, createdAt])
  @@index([ownerId])
  @@index([programmeId])
}

// =====================================================
// FICHE CLIENT ÉTENDUE — 1:1 avec User (CLIENT)
// =====================================================

model ClientProfile {
  id     String @id @default(cuid())
  userId String @unique

  birthName   String? // nom de naissance
  birthDate   DateTime?
  birthPlace  String?
  profession  String?
  nationality String?

  familyStatus     FamilyStatus?
  marriageDate     DateTime?
  marriagePlace    String?
  marriageContract String? // régime / contrat de mariage

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =====================================================
// NOTES PARTAGÉES — prospect ou dossier, visibles par tous les collaborateurs
// =====================================================

model Note {
  id         String    @id @default(cuid())
  scope      NoteScope
  prospectId String?
  dossierId  String?
  authorId   String
  body       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prospect Prospect? @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  dossier  Dossier?  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  author   User      @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([prospectId, createdAt])
  @@index([dossierId, createdAt])
}

// =====================================================
// RENDEZ-VOUS NOTAIRE — visible collaborateur / client / promoteur
// =====================================================

model Appointment {
  id          String            @id @default(cuid())
  dossierId   String
  scheduledAt DateTime
  location    String?
  notaryId    String?
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  createdBy User    @relation("AppointmentCreator", fields: [createdById], references: [id])

  @@index([dossierId, scheduledAt])
  @@index([scheduledAt])
}

// =====================================================
// FACTURES D'HONORAIRES — espace Facturation
// =====================================================

model Invoice {
  id          String        @id @default(cuid())
  dossierId   String
  number      String        @unique
  amountHT    Decimal       @db.Decimal(12, 2)
  vatRate     Decimal       @db.Decimal(5, 2)
  amountTTC   Decimal       @db.Decimal(12, 2)
  storageKey  String?       @unique // PDF de la facture sur S3
  fileName    String?
  status      InvoiceStatus @default(DRAFT)
  sentToNotaryAt DateTime?
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  createdBy User    @relation("InvoiceCreator", fields: [createdById], references: [id])

  @@index([dossierId])
  @@index([status])
}

model LotFondsSuivi {
  id                    String    @id @default(cuid())
  lotId                 String    @unique
  programmeId           String
  commission            Decimal?  @db.Decimal(12, 2)
  fraisMainLevee        Decimal?  @db.Decimal(12, 2)
  rbstEdd               Decimal?  @db.Decimal(12, 2)
  soldeVendeur          Decimal?  @db.Decimal(12, 2)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  lot          Lot           @relation(fields: [lotId], references: [id], onDelete: Cascade)
  programme    Programme     @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  fondsAppeles FondsAppele[]
}

model AppelFonds {
  id          String   @id @default(cuid())
  programmeId String
  numero      Int
  label       String
  datePrevue  DateTime
  pourcentage Decimal  @db.Decimal(5, 2)
  createdAt   DateTime @default(now())

  programme    Programme     @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  fondsAppeles FondsAppele[]

  @@unique([programmeId, numero])
  @@index([programmeId])
}

model FondsAppele {
  id           String  @id @default(cuid())
  lotFondsId   String
  appelFondsId String
  montant      Decimal @db.Decimal(12, 2)
  dateEnvoiLr           DateTime?
  dateReceptionVirement DateTime?
  createdAt    DateTime @default(now())

  lotFonds   LotFondsSuivi @relation(fields: [lotFondsId], references: [id], onDelete: Cascade)
  appelFonds AppelFonds    @relation(fields: [appelFondsId], references: [id], onDelete: Cascade)

  @@unique([lotFondsId, appelFondsId])
  @@index([appelFondsId])
}
